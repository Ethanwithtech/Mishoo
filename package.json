{
  "name": "mishoo",
  "version": "0.2.0",
  "private": true,
  "description": "Mishoo is a gentle desktop pet and break guardian for people who work at a computer.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --base=/mishoo/ --outDir dist-web",
    "start": "electron .",
    "desktop:frame": "python3 scripts/prepare-desktop-frame.py",
    "pets:covers": "python3 scripts/generate-pet-covers.py",
    "direction:audit": "node scripts/build-direction-sprite.mjs",
    "dist:win": "npm run desktop:frame && npm run build && electron-builder --win portable --x64",
    "video:key": "node scripts/key-video.mjs",
    "video:ai": "node scripts/ai-matting.mjs",
    "package:browsers": "pnpm run build && node scripts/package-browsers.mjs"
  },
  "keywords": [
    "break-reminder",
    "desktop-pet",
    "pomodoro",
    "electron",
    "wellbeing"
  ],
  "author": "Ethanwithtech",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "^8.1.5",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.ethanwithtech.mishoo",
    "productName": "Mishoo 咪咻",
    "asar": true,
    "files": [
      "dist/**/*",
      "!dist/downloads/*.exe",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Mishoo-${version}-Windows-${arch}.${ext}"
    }
  }
}
